# Copy to .env and fill in. Do NOT commit .env.

# development | production
DJANGO_ENV=development

SECRET_KEY=change-me

# Local Postgres in dev; the Neon connection string in production.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sevasync
# DB_CONN_MAX_AGE=0

# Production only (comma-separated)
# ALLOWED_HOSTS=your-service.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Firebase Admin credentials — choose ONE:
# (a) local: path to the service-account JSON
FIREBASE_CREDENTIALS=./sevasync-firebase-adminsdk.json
# (b) hosted (Render): the three key fields instead of a file
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Optional AI refiner
USE_GEMINI=false
# AI_API_KEY=your-google-genai-key
